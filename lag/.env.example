# Lag sniper. Copy to lag/.env and run from the repo root:
#   bun --env-file=lag/.env lag/src/index.ts

# true (default) paper-trades against live books and journals every signal.
DRY_RUN=true

# Live mode only. The EOA that holds pUSD and POL on Polygon. Never commit it.
# Run scripts/lag-setup.ts once to set the exchange approvals.
LAG_PRIVATE_KEY=
POLYGON_RPC_URL=

# Signal (defaults are the backtested setting).
# edge required after the taker fee, 0.01 = 1c
LAG_MARGIN=0.01
# baseline half-life; only moves fresher than this count
LAG_BASIS_HALF_LIFE_SEC=60
# per strike and side, after each signal
LAG_COOLDOWN_SEC=60
# entry band, the backtest's profitable favourites
LAG_MIN_PRICE=0.9
LAG_MAX_PRICE=0.99
LAG_TAKER_FEE_RATE=0.07

# Which strikes.
LAG_MAX_HOURS_LEFT=72
LAG_MIN_SECONDS_LEFT=30

# Risk caps, in pUSD.
LAG_MAX_TRADE_USD=20
LAG_MAX_STRIKE_USD=60
LAG_MAX_OPEN_USD=300
LAG_MAX_SPOT_AGE_MS=2000

# Amplifi VM API endpoint (the VM that has BTC daily-above markets ingested)
AMPLIFI_API_BASE=https://amplifi.018.api.t1protocol.com

# Bot wallet — generate with `cast wallet new`. Fund with USDC.e + POL on
# Polygon. Each of the three production bots should use its OWN keypair
# (don't share across profiles — independent capital, independent state).
BOT_PRIVATE_KEY=
BOT_ADDRESS=

# Bot capital cap. The allocator caps total deployment across the 6-day
# window at this value; any Amplifi balance above this stays idle. The
# operator funds the bot's Amplifi balance up front — the bot itself
# never auto-deposits. Top up manually whenever you want to scale up.
TOTAL_CAPITAL_USD=100

# Poll cadence for Gamma + state reconciliation. BTC daily markets resolve
# at the same noon-ET candle every day so sub-minute polling buys nothing.
POLL_INTERVAL_MS=60000

# 6 days, with the head-weighted allocation from the strategy doc:
#   <24h: 40%  | 24-48h: 25% | 48-72h: 12.5% | rest split equally (3 × 7.5%)
DAYS=6
DAY_WEIGHTS=0.4,0.25,0.125,0.075,0.075,0.075

# Comma-separated buckets this bot will trade. Allowed tokens:
#   0.90-0.95  → typically 4x
#   0.95-0.97  → typically 7x
#   0.97-0.99  → typically 8-10x
#   0.99+      → typically 10x
# Legacy alias `0.97+` expands to both 0.97-0.99 and 0.99+ (keeps old envs
# working). Leaving this blank trades all four buckets from a single pooled
# bankroll (not the default operational mode — used for backtesting /
# aggregate runs only).
BUCKETS=0.90-0.95

# Per-bucket leverage. Maker-optimal defaults from the 500ms backtest
# (production-mode $100, all-entries). A bot configured for a single bucket
# only uses its bucket's leverage value; the others are ignored.
#
# `LEVERAGE_97_PLUS` is the legacy single-value knob for the old 0.97+
# bucket; it now serves as a fallback for both 0.97-0.99 and 0.99+ when
# the more specific vars aren't set. Set both explicitly to use different
# leverage in the two upper buckets.
LEVERAGE_90_95=4
LEVERAGE_95_97=7
LEVERAGE_97_PLUS=10
# LEVERAGE_97_99=8
# LEVERAGE_99_PLUS=10

# Above/below restriction: when true, each day's allocation is split 50/50
# between strikes ABOVE current BTC (NO side) and strikes BELOW current
# BTC (YES side). Delta-neutralizes a single bot's BTC exposure. Per spec,
# enable this on exactly ONE of the three production profiles.
ABOVE_BELOW_RESTRICTED=false

# Per-market collateral floor. CLOB rejects orders < $1 notional, so $1 is
# the hard minimum; raise it to skip dust-sized day-slots (e.g. on Day 6
# with many qualifying markets, a $100 bot might compute $1.25 per slot —
# raising the floor to $2 leaves Day 6 unfilled and concentrates capital).
COLLATERAL_FLOOR_USD=1

# Maker-first order placement: the bot posts a GTC limit at best-bid via
# /polymarket/orders instead of crossing the spread with a market order.
# Empirically ~97% of fills land as maker on Polymarket BTC daily-above
# markets (harvester bot's measurement) — avoids the 1-2¢ taker fee that
# the maker-optimal backtest assumed away.

# How long a slot may sit RESTING before we check whether to reprice. The
# reprice check only cancels if the book's best-bid has actually moved up
# — otherwise the order stays put even past this age. 600s = 10 min is a
# reasonable balance between catching real drift and not churning during
# normal bid-stack thrash.
MAKER_MAX_RESTING_AGE_SEC=600

# Cap on cancel+replace cycles per slot. Bounds the cost of pathological
# drift (a strike whose best-bid races up faster than we can chase). After
# this many reprices the bot leaves the order in place and accepts that
# the slot may not fill.
MAKER_MAX_REPRICES_PER_SLOT=5

# Tick-size fallback when CLOB /book omits `tick_size`. 0.001 (0.1¢) is the
# safer default since BTC daily-above strikes mostly trade at deep-ITM or
# deep-OTM prices where the 0.001 tick applies. Only the at-the-money 80k
# strike uses 0.01.
MAKER_DEFAULT_TICK_SIZE=0.001

# Optional take-profit. When set, the bot places a TP limit-sell as soon as
# a slot's buy fills. The TP fires when ROE on the slot's collateral reaches
# this value:
#   tpPrice = fillPrice × (1 + TP_ROE_PCT / (leverage × 100))
# e.g. a 4x position at $0.92 with TP_ROE_PCT=5 → raw TP $0.9315 → ceiled
# to the side's tick ($0.932 at the typical 0.001 tick). Round-up is
# deliberate — rounding down could leave TP at or below the fill.
# After a TP fires, the position closes and the freed margin is recycled by
# the next allocator pass (same day-weight / bucket / leverage rules apply).
# Leave unset / blank to disable: positions ride to resolution like before.
# TP_ROE_PCT=

# Active take-profit exit (volume-first). When true AND TP_ROE_PCT is set: if
# the book has already bid PAST the ROE target by the time the bot registers
# the TP (the "must be above current best bid" rejection), close the position
# at market to bank the (>= target) profit and recycle the collateral now —
# instead of parking a resting TP at the fixed 0.999 ceiling, which sits behind
# the deep-ITM sell wall and rides to resolution with no recycling. Crossing
# the spread costs a tiny taker fee (~0 deep-ITM, where p·(1−p) is small).
# Default false (ride-to-resolution). Recommended for volume-focused fleets.
# TP_ACTIVE_EXIT=false

# Order placement mode.
#   maker (default) — post GTC limit at best-bid via /polymarket/orders.
#                     Earns the maker rebate; subject to reprice churn if
#                     the best-bid runs away.
#   taker           — immediate FAK market open via /polymarket/positions/open.
#                     No resting order, no reprice. Higher fee in theory, but
#                     Polymarket's fee schedule collapses to ~0 at deep-ITM /
#                     deep-OTM prices so the practical cost is tiny on these
#                     markets — and there's no fill-race against the price.
# ORDER_MODE=maker

# Hard ceiling on entry mid-price. Strikes whose qualifying side trades at
# or above this are skipped entirely — the per-share upside (1 − p) has
# nothing left to give once you net out fee + interest. 0.996 cuts the top
# end of the 0.99+ bucket that historically contributed disproportionately
# to liquidations.
# MAX_ENTRY_PRICE=0.996

# Interest-aware ROI floor on collateral, as a percent. When set together
# with LENDING_POOL_ADDRESS, qualifying strikes must clear this hurdle
# after subtracting borrow interest accrued through resolution. The bot
# reads live `borrowRate()` from the lending pool every ~5 min. Below 0.99
# the natural upside is so much bigger than any realistic APR that this
# gate never bites; in practice it only matters in the 0.99-to-
# MAX_ENTRY_PRICE band. Fails CLOSED on RPC failure — placements skipped
# for the cycle, no existing slots touched.
# MIN_ROI_AFTER_INTEREST_PCT=2

# Polygon address of the AmplifiLendingPool the ROI gate reads `borrowRate`
# from. Required when MIN_ROI_AFTER_INTEREST_PCT is set. Match the address
# the VM is using (the same pool that funds bot loans).
# LENDING_POOL_ADDRESS=

# Bucket-stability gate. When set, the bot only opens a target if it has
# observed the market continuously in that bucket for at least this many
# minutes. Bucket transitions reset the timer; a bot pause longer than
# 3× POLL_INTERVAL_MS also resets via the `maxGapMs` check. Persisted to
# the state file so a quick restart preserves the streak.
# BUCKET_STABILITY_WINDOW_MIN=15

# Optional cap on per-target collateral. With many qualifying strikes you
# get the natural day-budget / N share; this clamps each slot down so a
# day with one qualifying market can't soak the whole day-budget. Surplus
# capital stays idle when fewer slots than the cap is configured for fire.
# MAX_POSITION_COLLATERAL_USD=15

# Optional time-to-resolution filter. When set, the bot ignores any market
# whose resolution time is more than this many hours from now. Empirical
# liquidation rates across simulated bucket-bot fills show a cliff at 36h:
# <24h ~10% liq, 24-36h ~13%, 36-48h ~33%, 48-72h ~50%, 72h+ ~67%. Gating
# entries to `<= 36h` cuts the tail without giving up most of the upside
# (the daily bond's largest move is in the final 24h regardless of entry).
# Leave unset / blank to trade every day in the DAYS window.
# MAX_HOURS_TO_RESOLUTION=36

# Per-bucket time-to-resolution gates (override the global above per entry
# bucket). Each defaults to MAX_HOURS_TO_RESOLUTION / MIN_HOURS_TO_RESOLUTION.
# Empirically the deep 0.97-0.99 bucket only profits opened close to
# resolution (~<=18h) while shallow buckets (0.90-0.97) and 0.99+ stay +EV up
# to ~24h; ALL buckets bleed at 24h+. So the recommended setup is a 24h global
# cap with a tighter 0.97-0.99 cap:
#   MAX_HOURS_TO_RESOLUTION=24
#   MAX_HOURS_97_99=18
# Full set (all optional; unset = fall back to the global, then no bound):
# MAX_HOURS_90_95=24
# MAX_HOURS_95_97=24
# MAX_HOURS_97_99=18
# MAX_HOURS_99_PLUS=24
# MIN_HOURS_TO_RESOLUTION=          # global floor (skip entries too close to settlement)
# MIN_HOURS_90_95=
# MIN_HOURS_95_97=
# MIN_HOURS_97_99=
# MIN_HOURS_99_PLUS=

# When true, decisions are logged but no intents are sent.
DRY_RUN=true

# Optional: Polygon RPC override for the USDC.nonces() read on deposit.
# Empty value is treated as unset; commented out uses https://polygon-rpc.com.
# POLYGON_RPC_URL=

# Optional: explicit state-file path. Leaves the mode-aware default
# (.state.dry.json in dry-run, .state.live.json in live mode) when unset.
# Override only when running multiple live profiles from the same checkout:
#   STATE_FILE=bucket/.state.live.90-95.json
# STATE_FILE=

# Gamma series id for the BTC daily-above markets. Defaults to 45.
# BTC_DAILY_SERIES_ID=45

# Seconds between market polls. Defaults to 60000 (60s).
# POLL_INTERVAL_MS=60000

# Starting equity used only on the very first cycle, before the backend has
# reported a live balance. Position sizing follows live equity after that.
# INITIAL_DEPOSIT_USD=100

# Anti-volatility open-gate. Blocks opening NEW positions during a BTC move;
# never touches existing positions, take-profits or closes.
# Each rule is WINDOW:THRESHOLD_PCT[:dir], windows in s/m/h/d. A ":dir" rule is
# DIRECTIONAL: it blocks only the side the move works against, so a rise blocks
# NO and a fall blocks YES. Without ":dir" a rule blocks both sides.
# The live fleet setting is the directional pair below.
VOL_GATE_ENABLED=true
VOL_GATE_RULES=48h:5.0:dir,15m:1.0:dir

# Milliseconds between BTC spot polls feeding the gate. Defaults to 20000.
# BTC_VOL_POLL_MS=20000

# Block opens for this long after THIS bot's own liquidation. Unset = off,
# which is the live setting.
# REENTRY_COOLDOWN_MS=3600000

# Drift stop-loss: register a server-side stop that closes the position once it
# has lost this fraction of its initial margin. OFF on the live fleet since
# 2026-08-11 — every stop level tested loses to no stop at all, because the
# stop converts price recoveries into realized losses (the liquidation penalty
# and the stop fee both return to t1, so per-event cost is near-identical and
# only the event COUNT differs).
STOP_LOSS_ENABLED=false
# STOP_LOSS_MARGIN_FRACTION=0.6
